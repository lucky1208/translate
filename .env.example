# 复制成 .env 或直接写进 systemd 的 Environment=
PORT=8787

# ---- 阿里云百炼 ----
# 地域、Key、模型三者绑定,不能混用。Gummy 只在北京地域提供。
ALIYUN_API_KEY=sk-xxxxxxxxxxxxxxxx
# 北京通用    wss://dashscope.aliyuncs.com/api-ws/v1/inference
# 新加坡通用  wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference
# 专属域名    wss://ws-xxxx.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/inference
ALIYUN_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ALIYUN_MODEL=gummy-realtime-v1

# ---- 火山引擎 语音技术 ----
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel

# ---- 火山方舟(翻译)----
ARK_API_KEY=
ARK_MODEL=doubao-seed-1-6-flash-250828

# ---- 自签 / 正式证书,填了就起 https ----
# TLS_CERT=/path/fullchain.pem
# TLS_KEY=/path/privkey.pem
